{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Daily LLM scores (llm/scores.json)",
 "type": "object",
 "required": ["date", "regime", "coins", "top10", "claude_volne"],
 "properties": {
  "date": {"type": "string", "description": "YYYY-MM-DD, date of the run"},
  "regime": {"type": "object", "required": ["label", "summary"],
   "properties": {"label": {"type": "string"}, "summary": {"type": "string"}}},
  "events_7d": {"type": "array", "items": {"type": "object",
   "properties": {"date": {"type": "string"}, "title": {"type": "string"},
    "type": {"enum": ["makro", "unlock", "upgrade", "listing", "regulace", "jine"]}}}},
  "coins": {"type": "object", "description": "one entry per universe coin, key = symbol (e.g. BTC)",
   "additionalProperties": {"type": "object",
    "required": ["trend", "mr", "news", "conviction", "p_outperform_btc_7d", "p_up_7d", "expected_move_7d_pct",
                 "event", "event_type", "risk_flag", "note", "sources"],
    "properties": {
     "trend": {"type": "integer", "minimum": -2, "maximum": 2},
     "mr": {"type": "integer", "minimum": -2, "maximum": 2},
     "news": {"type": "integer", "minimum": -2, "maximum": 2},
     "conviction": {"type": "integer", "minimum": 1, "maximum": 5},
     "p_outperform_btc_7d": {"type": "number", "minimum": 0, "maximum": 1},
     "p_up_7d": {"type": "number", "minimum": 0, "maximum": 1},
     "expected_move_7d_pct": {"type": "number"},
     "event": {"type": "boolean"},
     "event_type": {"enum": ["unlock", "upgrade", "listing", "hack", "regulace", "jine", "none"]},
     "risk_flag": {"type": "boolean"},
     "risk_reason": {"type": "string"},
     "note": {"type": "string", "description": "one Czech sentence"},
     "sources": {"type": "array", "items": {"type": "string", "format": "uri"}, "maxItems": 5}}}},
  "top10": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "required": ["coin", "reason"],
   "properties": {"coin": {"type": "string"}, "reason": {"type": "string"}}}},
  "claude_volne": {"type": "object", "required": ["positions"],
   "properties": {"comment": {"type": "string"},
    "positions": {"type": "array", "maxItems": 10, "items": {"type": "object",
     "required": ["coin", "weight_pct", "reason", "invalidation"],
     "properties": {"coin": {"type": "string"}, "weight_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 25},
      "reason": {"type": "string"}, "invalidation": {"type": "string"}}}}}}
 }
}
