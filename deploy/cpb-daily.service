[Unit]
Description=crypto-paper-bot daily run (paper trading, no real money)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=cpb
Group=cpb
WorkingDirectory=/home/cpb/crypto-paper-bot
Environment=CPB_ENV=/home/cpb/.config/cpb/env
Environment=CPB_PUBLISH_DIR=/srv/cpb
ExecStart=/home/cpb/crypto-paper-bot/run_daily.sh
TimeoutStartSec=80min
Nice=5
# hardening: the run only writes its repo, its home (claude session files) and the web root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/cpb
ReadWritePaths=/srv/cpb
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0022
