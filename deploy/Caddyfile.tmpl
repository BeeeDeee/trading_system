# crypto-paper-bot dashboard: static files only, HTTPS, basic auth. Generated by deploy/install.sh.
{
	email {{ACME_EMAIL}}
	servers {
		protocols h1 h2
	}
}

{{SITE}} {
	{{TLS}}
	encode gzip
	basic_auth {
		{{USER}} {{BCRYPT_HASH}}
	}
	# dashboards portal: / = tab shell, /crypto/ /lab/ /evening/ = the dashboards (same origin, iframed by the shell)
	redir /crypto /crypto/
	redir /lab /lab/
	redir /evening /evening/
	redir /data.json /crypto/data.json
	handle_path /crypto/* {
		root * /srv/cpb/current
		@cpb path / /index.html /data.json
		handle @cpb {
			file_server
		}
		handle {
			respond 404
		}
	}
	# research-lab dashboard (static, generated by labcore after every cycle)
	handle_path /lab/* {
		root * /srv/research-lab/web/current
		file_server
	}
	# evening bot dashboard (static, generated on this server after every run)
	handle_path /evening/* {
		root * /srv/evening/current
		file_server
	}
	@portal path / /index.html
	handle @portal {
		root * /srv/portal/current
		file_server
	}
	handle {
		respond 404
	}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000"
		# script-src is narrowed further by the page's own CSP meta tag (hash of its single inline script)
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-src 'self'; frame-ancestors 'self'"
		-Server
	}
	# access log to the systemd journal (fail2ban reads it there): no log file, no file permissions to get wrong
	log {
		output stderr
		format json
	}
}
