# crypto-paper-bot dashboard: static files only, HTTPS, basic auth. Generated by deploy/install.sh.
{
	email {{ACME_EMAIL}}
	servers {
		protocols h1 h2
	}
}

{{SITE}} {
	{{TLS}}
	encode gzip
	root * /srv/cpb/current
	basic_auth {
		{{USER}} {{BCRYPT_HASH}}
	}
	@allowed path / /index.html /data.json
	handle @allowed {
		file_server
	}
	handle {
		respond 404
	}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		# script-src is narrowed further by the page's own CSP meta tag (hash of its single inline script)
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
	# access log to the systemd journal (fail2ban reads it there): no log file, no file permissions to get wrong
	log {
		output stderr
		format json
	}
}
