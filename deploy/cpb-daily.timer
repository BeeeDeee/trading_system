[Unit]
Description=crypto-paper-bot daily run 06:00 Europe/Prague (retries 10:00 and 14:00 are no-ops once the day is done)

[Timer]
# Prague local time: 04:00 UTC in summer, 05:00 UTC in winter (DST handled by systemd). The decision still uses the
# daily candle closed at 00:00 UTC; the run date is the UTC date.
OnCalendar=*-*-* 06:00:00 Europe/Prague
OnCalendar=*-*-* 10:00:00 Europe/Prague
OnCalendar=*-*-* 14:00:00 Europe/Prague
Persistent=true
AccuracySec=1min
Unit=cpb-daily.service

[Install]
WantedBy=timers.target
