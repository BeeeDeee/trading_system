# Copy to .env (gitignored) and fill in. Never commit real values.

# ─── Data vendor — Sharadar Bundle (~$29/mo). One month is enough to bulk-download. ─
SCOUT_SHARADAR_API_KEY=<REDACTED>
# unused unless data.vendor is norgate:
SCOUT_NORGATE_USER=
SCOUT_NORGATE_PASSWORD=

# ─── Broker credentials — required for M5 paper/live only ─────────────────────
SCOUT_BROKER_API_KEY=
SCOUT_BROKER_API_SECRET=

# ─── Kill switch ─────────────────────────────────────────────────────────────
# Set to 0 to immediately block all new risk-opening orders. Re-read before
# every order send in live mode, so no restart is needed.
SCOUT_TRADING_ENABLED=1

# ─── Optional config overrides (SCOUT_<SECTION>__<FIELD>) ────────────────────
# Use sparingly: env overrides are NOT captured in the run's config.yaml, which
# harms reproducibility. Intended for secrets and the kill switch only.
SCOUT_LOGGING__LEVEL=INFO
